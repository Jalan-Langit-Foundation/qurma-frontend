
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# true = tombol "Mulai Tabungan" ke halaman daftar; false = ke WhatsApp admin
NEXT_PUBLIC_SAVING_REGISTRATION_OPEN=false

# true = halaman /design-system tetap tampil di production
NEXT_PUBLIC_ENABLE_DESIGN_SYSTEM=false

# Alamat API Laravel, termasuk /api (wajib di production)
API_BASE_URL=http://localhost:8000/api

# Batas waktu request ke backend dalam milidetik (opsional, default 15000)
# API_TIMEOUT_MS=15000

# URL panel admin Filament, ditampilkan saat akun admin mencoba login di website (opsional)
# ADMIN_PANEL_URL=http://localhost:8000/admin